# 복사해서 server/.env 로 쓴다. .env는 커밋 금지 (gitignore에 이미 걸려 있음)

# --- DB ---
# docker compose up -d db 로 띄운 기본값
# 컨테이너는 5433으로 노출한다 — 5432는 로컬 PostgreSQL과 충돌할 수 있다
DATABASE_URL=postgresql+psycopg://mjc:mjc@localhost:5433/mjc

# --- JWT ---
# 운영이라면 반드시 바꾼다. 비워두면 개발용 기본값이 쓰인다
JWT_SECRET=

# --- 인증 메일 ---
# SMTP_HOST를 비워두면 메일을 보내지 않고 인증번호·링크를 서버 콘솔에 찍는다.
# 데모 당일 메일이 막혀도 시연이 죽지 않게 하기 위한 이중화다.
#
# 실제로 메일을 보내려면 — 설정 절차와 선택 기준은 server/EMAIL.md.
# 소유한 도메인이 없으면 Gmail 앱 비밀번호가 낫다 (릴레이로 gmail 주소를 보내면 걸러진다).
#   SMTP_HOST=smtp.gmail.com
#   SMTP_USER=<본인 Gmail 주소 전체>
#   SMTP_PASSWORD=<앱 비밀번호 16자, 공백 제거 — 계정 비밀번호가 아니다>
#   SMTP_FROM=   ← 비워둔다. Gmail은 발신 주소가 인증 계정과 같아야 한다
# 도메인이 있으면 Brevo(무료 300건/일): smtp-relay.brevo.com + SMTP key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 비워두면 SMTP_USER를 쓴다. Brevo처럼 인증된 발신자가 따로면 여기에 적는다
SMTP_FROM=
SMTP_FROM_NAME=MJC 취업 로드맵
# 465 포트를 쓰는 릴레이면 true. 587이면 비워둔다 (STARTTLS로 올린다)
SMTP_USE_SSL=
# TLS를 안 받는 로컬 테스트 메일 서버(Mailpit 등)에 붙일 때만 false
SMTP_USE_TLS=

# --- 인증 링크가 오가는 주소 ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# 인증 후 교환 코드를 들고 도착할 프론트 경로 (기존 라우트를 쓴다)
VERIFY_LANDING=/app/roadmap

# --- LLM (4단계) ---
ANTHROPIC_API_KEY=
