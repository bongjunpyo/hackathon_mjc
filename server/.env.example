# 복사해서 server/.env 로 쓴다. .env는 커밋 금지 (gitignore에 이미 걸려 있음)

# --- DB ---
# docker compose up -d db 로 띄운 기본값
DATABASE_URL=postgresql+psycopg://mjc:mjc@localhost:5432/mjc

# --- JWT ---
# 운영이라면 반드시 바꾼다. 비워두면 개발용 기본값이 쓰인다
JWT_SECRET=

# --- 인증 메일 ---
# 아래를 비워두면 메일을 보내지 않고 인증 링크를 서버 콘솔에 찍는다.
# 데모 당일 메일이 막혀도 시연이 죽지 않게 하기 위한 이중화다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- 인증 링크가 오가는 주소 ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# 인증 후 교환 코드를 들고 도착할 프론트 경로 (기존 라우트를 쓴다)
VERIFY_LANDING=/app/input

# --- LLM (4단계) ---
ANTHROPIC_API_KEY=
